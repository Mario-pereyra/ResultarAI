# ResultarAI Environment Variables Example

# Database Configuration (for postgres adapter in b04)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resultarai
DB_USER=postgres
DB_PASSWORD=postgres

# LiteLLM Configuration (for llm adapter in b05)
# LITELLM_LOG=DEBUG

# DeepSeek via LiteLLM (proveedor de pruebas durante el desarrollo; LiteLLM
# lee esta variable automáticamente para los modelos "deepseek/...")
DEEPSEEK_API_KEY=sk-...

# Langfuse Configuration (for tracing adapter in b07)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
